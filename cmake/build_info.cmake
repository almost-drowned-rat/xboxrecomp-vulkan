# build_info.cmake - run with `cmake -P` at every build (platform/CMakeLists.txt, target xr_build_info):
# writes OUT, a header with the short commit of the game repo (GAME_DIR) and of the toolkit (TOOLKIT_DIR),
# "-dirty" when tracked files differ, "unknown" without git. The file is rewritten only when the text changes,
# so host_info.c recompiles only after a commit. A release's prebuilt libraries carry the commits they were
# built from (the player's PC builds only the port's sources).
function(xr_commit dir out)
    set(c "unknown")
    find_program(XR_GIT git)
    if(XR_GIT AND EXISTS "${dir}")
        execute_process(COMMAND "${XR_GIT}" -C "${dir}" rev-parse --short=7 HEAD
                        OUTPUT_VARIABLE h RESULT_VARIABLE r ERROR_QUIET OUTPUT_STRIP_TRAILING_WHITESPACE)
        if(r EQUAL 0 AND h)
            set(c "${h}")
            execute_process(COMMAND "${XR_GIT}" -C "${dir}" status --porcelain --untracked-files=no
                            OUTPUT_VARIABLE s RESULT_VARIABLE r ERROR_QUIET OUTPUT_STRIP_TRAILING_WHITESPACE)
            if(r EQUAL 0 AND s)
                set(c "${c}-dirty")
            endif()
        endif()
    endif()
    set(${out} "${c}" PARENT_SCOPE)
endfunction()

xr_commit("${GAME_DIR}" game)
xr_commit("${TOOLKIT_DIR}" toolkit)
set(text "/* generated by cmake/build_info.cmake - do not edit */\n#define XR_GAME_COMMIT \"${game}\"\n#define XR_TOOLKIT_COMMIT \"${toolkit}\"\n")
if(EXISTS "${OUT}")
    file(READ "${OUT}" old)
else()
    set(old "")
endif()
if(NOT old STREQUAL text)
    file(WRITE "${OUT}" "${text}")
endif()
